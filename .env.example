# Copy to .dev.vars (local) — production values go in Cloudflare (Workers > put-and-go > Settings > Variables and secrets).
# Never commit real values.

# Public site URL (canonical URLs, sitemap, WhatsApp product links). Also a BUILD variable in Workers Builds.
NEXT_PUBLIC_SITE_URL=https://put-and-go.arona-easyoil.workers.dev

# --- Shopify (commerce backend) ---
# e.g. put-and-go.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-10
# Storefront API: use the private token (server-side, preferred) OR the public token.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Admin API token (custom app) — needed for newsletter signups and the import tool. Scopes: write_products, write_customers.
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Webhook signing secret (Shopify Admin > Settings > Notifications > Webhooks)
SHOPIFY_WEBHOOK_SECRET=
# Shopify base currency (draft import validation)
SHOPIFY_BASE_CURRENCY=XOF
# Shopify customer accounts URL, e.g. https://shopify.com/<shop-id>/account
SHOPIFY_ACCOUNT_URL=

# --- Instagram (official API, token issued to the PUT & GO business account) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- Import review tool (/admin/import) — random string of 32+ characters ---
IMPORT_ADMIN_TOKEN=

# --- Optional ---
HERO_IMAGE_URL=
HERO_VIDEO_URL=
# Cloudflare Web Analytics beacon token (BUILD variable; loaded only after cookie consent)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
